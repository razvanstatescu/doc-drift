{
  "name": "dds-bitbucket-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Doc Drift Sentinel Relay: sends merged Bitbucket pull requests to Doc Drift Sentinel as HMAC-signed change records",
  "license": "UNLICENSED",
  "scripts": {
    "build:shared": "cd ../../packages/shared && pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "predeploy": "npm run build:shared && npm run typecheck && npm test",
    "deploy": "forge deploy -e development --non-interactive"
  },
  "dependencies": {
    "@dds/shared": "file:../../packages/shared",
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/events": "^3.0.10",
    "@forge/kvs": "^2.1.2",
    "@forge/react": "^12.5.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
