{
  "name": "@dds/matcher",
  "version": "0.1.0",
  "private": true,
  "description": "Doc Drift Sentinel deterministic matcher: anchors, scoring, severity, page state",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "vitest run test/eval.test.ts --reporter=default"
  },
  "dependencies": {
    "@dds/shared": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
